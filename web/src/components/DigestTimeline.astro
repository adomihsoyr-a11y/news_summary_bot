---
import { getCollection } from "astro:content";

const digests = (await getCollection("digests")).sort(
	(a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate),
);

const fmt = new Intl.DateTimeFormat("ja-JP", {
	year: "numeric",
	month: "numeric",
	day: "numeric",
	hour: "2-digit",
	minute: "2-digit",
});
const getLang = (id: string) => id.split(/[\/_]/)[0];

const TZ = "Asia/Tokyo";
const dayKey = (d: Date) => d.toLocaleDateString("sv-SE", { timeZone: TZ }); // "YYYY-MM-DD"
const dayFmt = new Intl.DateTimeFormat("ja-JP", {
	timeZone: TZ,
	year: "numeric",
	month: "long",
	day: "numeric",
	weekday: "short",
});
---

<section id="digests" aria-label="Digests">
	{
		digests.map((digest, i) => {
			const date = new Date(digest.data.pubDate);
			const prev = digests[i - 1];
			const showDay =
				i === 0 || dayKey(date) !== dayKey(new Date(prev.data.pubDate));

			return (
				<>
					{showDay && (
						<div class="day-separator" role="separator">
							<span>{dayFmt.format(date)}</span>
						</div>
					)}

					<article class="post">
						<div class="avatar" aria-hidden="true">
							{getLang(digest.id) === "en" && (
								<svg
									viewBox="0 0 19 10"
									preserveAspectRatio="xMinYMid slice"
								>
									<rect width="19" height="10" fill="#fff" />
									{[0, 2, 4, 6, 8].map((n) => (
										<rect
											y={n * (10 / 9)}
											width="19"
											height={10 / 9}
											fill="#B22234"
										/>
									))}
									<rect
										width="7.6"
										height="5.4"
										fill="#3C3B6E"
									/>
								</svg>
							)}
							{getLang(digest.id) === "jp" && (
								<svg
									viewBox="0 0 3 2"
									preserveAspectRatio="xMidYMid slice"
								>
									<rect width="3" height="2" fill="#fff" />
									<circle
										cx="1.5"
										cy="1"
										r="0.6"
										fill="#BC002D"
									/>
								</svg>
							)}
						</div>

						<div class="body">
							<p class="byline">
								{getLang(digest.id) === "en" ? (
									<span class="name">Market Digest</span>
								) : (
									<span class="name">市場 ダイジェスト</span>
								)}
								<span class="handle">@{digest.data.model || digest.id}</span>
								<time
									class="time"
									datetime={date.toISOString()}
								>
									{fmt.format(date)}
								</time>
							</p>

							<h2 class="title">
								<a href={`digests/${digest.id}`}>
									{digest.data.title}
								</a>
							</h2>

							<p class="description">{digest.data.description}</p>

							<p class="more" aria-hidden="true">
								続きを読む
								<svg
									viewBox="0 0 16 16"
									width="14"
									height="14"
									fill="none"
									stroke="currentColor"
									stroke-width="1.75"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<path d="M6 3.5 10.5 8 6 12.5" />
								</svg>
							</p>
						</div>
					</article>
				</>
			);
		})
	}
</section>

<style>
	#digests {
		--surface: #ffffff;
		--ink: #1d2433;
		--muted: #5d6678;
		--line: #d5dbe6;
		--accent: #2f5bea;
		--pad: 1rem;
		--rail: 3rem;

		max-width: 40rem;
		margin: 2rem auto;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 1rem;
		overflow: hidden;
		font-family:
			system-ui,
			-apple-system,
			"Hiragino Sans",
			"Yu Gothic UI",
			"Noto Sans JP",
			sans-serif;
		color: var(--ink);
		word-break: auto-phrase;
		overflow-wrap: anywhere;
	}

	@media (prefers-color-scheme: dark) {
		#digests {
			--surface: #1a1f2a;
			--ink: #e8ebf2;
			--muted: #98a1b3;
			--line: #2a3140;
			--accent: #7d9bff;
		}
	}
	.day-separator {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin: 1.5rem 0 0.75rem;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--muted, #6b7280);
	}
	.day-separator::before,
	.day-separator::after {
		content: "";
		flex: 1;
		height: 1px;
		background: currentColor;
		opacity: 0.25;
	}

	.post {
		position: relative;
		display: grid;
		grid-template-columns: var(--rail) minmax(0, 1fr);
		column-gap: 0.875rem;
		padding: var(--pad) var(--pad) 1.25rem;
		transition: background-color 0.15s ease;
	}
	.post:hover {
		background: color-mix(in srgb, var(--accent) 5%, var(--surface));
	}

	/* Thread line connecting avatars */
	.post::before {
		content: "";
		position: absolute;
		left: calc(var(--pad) + var(--rail) / 2 - 1px);
		top: 0;
		bottom: 0;
		width: 2px;
		background: var(--line);
		z-index: 0;
	}
	.post:first-child::before {
		top: calc(var(--pad) + var(--rail) / 2);
	}
	.post:last-child::before {
		bottom: auto;
		height: calc(var(--pad) + var(--rail) / 2);
	}
	.post:only-child::before {
		display: none;
	}

	.avatar {
		position: relative;
		z-index: 1;
		display: grid;
		place-items: center;
		width: var(--rail);
		height: var(--rail);
		border-radius: 50%;
		overflow: hidden;
		color: #fff;
		background: var(--accent);
		box-shadow: 0 0 0 4px var(--surface);
		transition: box-shadow 0.15s ease;
	}
	.post:hover .avatar {
		box-shadow: 0 0 0 4px
			color-mix(in srgb, var(--accent) 5%, var(--surface));
	}

	.body {
		min-width: 0;
	}

	.byline {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.15rem 0.5rem;
		margin: 0.15rem 0 0.25rem;
		font-size: 0.875rem;
	}
	.name {
		font-weight: 650;
	}
	.handle,
	.time {
		color: var(--muted);
	}
	.handle {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.time {
		margin-left: auto;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	.title {
		margin: 0 0 0.35rem;
		font-size: 1.15rem;
		line-height: 1.4;
		letter-spacing: -0.01em;
	}
	.title a {
		color: inherit;
		text-decoration: none;
	}
	/* Whole post is clickable */
	.title a::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 2;
	}
	.title a:focus-visible {
		outline: none;
	}
	.title a:focus-visible::after {
		outline: 2px solid var(--accent);
		outline-offset: -2px;
	}

	.description {
		margin: 0;
		color: var(--muted);
		line-height: 1.7;
		font-size: 0.95rem;
	}

	.more {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		margin: 0.75rem 0 0;
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--accent);
	}

	@media (max-width: 480px) {
		#digests {
			--rail: 2.5rem;
			margin: 0;
			border-radius: 0;
			border-inline: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.post,
		.avatar {
			transition: none;
		}
	}
</style>
